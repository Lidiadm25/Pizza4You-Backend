# Pizza4You - Environment Variables
# Copy this file to application-local.properties and fill in your own values

# Database
DB_URL=jdbc:mysql://localhost:3306/proyecto_final?useLegacyDatetimeCode=false&serverTimezone=Europe/Madrid
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# JWT Secret (min 32 characters)
JWT_SECRET=your_jwt_secret_here_min_32_chars_long

# Stripe API Key
STRIPE_API_KEY=sk_test_your_stripe_test_key_here

# Firebase Service Account Path (optional)
# FIREBASE_SA_PATH=path/to/firebase-service-account.json
